{
  "name": "myexpenses",
  "version": "1.0.0",
  "description": "MyExpenses — personal expense tracker on SAP CAP",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sap/cds": "^10",
    "@cap-js/hana": "^3",
    "@sap/hana-client": "^2",
    "@sap/xssec": "^4",
    "exceljs": "^4.4.0",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "@cap-js/cds-test": "^1",
    "chai": "^6",
    "chai-as-promised": "^8",
    "mocha": "^10",
    "@wdio/cli": "^8",
    "@wdio/local-runner": "^8",
    "@wdio/mocha-framework": "^8",
    "@wdio/spec-reporter": "^8",
    "wdio-ui5-service": "^2"
  },
  "sapux": [
    "app/myexpenses"
  ],
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "test": "NODE_ENV=test mocha test/service.test.js --timeout 60000 && NODE_ENV=test mocha test/myexpenses.test.js --timeout 60000",
    "test:e2e": "wdio run wdio.conf.js"
  },
  "cds": {
    "requires": {
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db/myexpenses.sqlite"
          }
        },
        "auth": {
          "kind": "mocked"
        }
      },
      "[test]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "auth": {
          "kind": "mocked"
        }
      },
      "[production]": {
        "db": {
          "kind": "hana",
          "deploy-format": "hdbtable"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
