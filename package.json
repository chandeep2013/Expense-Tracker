{
  "name": "travel-expense",
  "version": "1.0.0",
  "description": "Travel expense claim capture and approval",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sap/cds": "^10",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "@cap-js/cds-test": "^1",
    "chai": "^6",
    "chai-as-promised": "^8",
    "mocha": "^10",
    "@wdio/cli": "^8",
    "@wdio/local-runner": "^8",
    "@wdio/mocha-framework": "^8",
    "@wdio/spec-reporter": "^8",
    "wdio-ui5-service": "^2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "test": "mocha test/*.test.js --timeout 60000",
    "test:e2e": "wdio run wdio.conf.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "[development]": {
        "auth": {
          "kind": "dummy"
        }
      }
    }
  }
}
